# ─────────────────────────────────────────────────────────────────────────────
# Bitirme Proje Takip — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and should NEVER be committed to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite database file (relative to the project root)
DB_PATH=project_tracker.db

# ── Auth ──────────────────────────────────────────────────────────────────────
# Default password assigned to every new user on first sync.
# Users are forced to change this on their first login.
DEFAULT_PASSWORD=12345

# Minimum length for user-chosen passwords (must be >= 6)
MIN_PASSWORD_LEN=6

# ── Admin ─────────────────────────────────────────────────────────────────────
# Comma-separated normalized keys (lowercase, no spaces, no diacritics)
# of advisor accounts that have admin/database-reset privileges.
ADMIN_ADVISOR_KEYS=drufukasil,drufukasl

# Name used as advisor fallback when the CSV row has no advisor column.
DEFAULT_ADVISOR=Dr. UFUK ASIL

# ── File Uploads ──────────────────────────────────────────────────────────────
# Directory where student evidence files are saved (relative path).
UPLOADS_DIR=uploads

# ── Localisation ──────────────────────────────────────────────────────────────
# Default UI language: 'tr' (Turkish) or 'en' (English)
DEFAULT_LANGUAGE=tr

# ── AI / LLM Configuration ───────────────────────────────────────────────────
# Active provider: 'auto', 'gemini', 'ollama', 'groq', or 'openai'
# In 'auto' mode: uses Gemini if GEMINI_API_KEY is present, else Groq if GROQ_API_KEY is present,
# else Ollama if running on localhost, else graceful offline heuristic engine (never crashes).
AI_PROVIDER=auto

# Google Gemini API (Recommended for cloud demos, e.g. Streamlit Cloud)
# Can also be set via Streamlit Secrets: GEMINI_API_KEY = "..."
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional: Groq / OpenAI compatible API
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

